#!/bin/sh
#
# wifi-diag -- one-shot summary of OpenIPC wifi state, with a small
# catch-up tool for the misconfiguration that strands a board the
# most often:
#
#   wlandev is set to a value that /etc/wireless/usb does not match,
#   modprobe never runs for the dongle, wlan0 never comes up, and
#   S40network parks eth0 on 192.168.2.10 so the user can ssh back
#   in. Without this script the only way out is to know which env
#   var to clear and what to set it to.

PROG=$(basename "$0")

action=show
say=no
WLANDEV_OVERRIDE=
while [ $# -gt 0 ]; do
	case "$1" in
		--fix-wlandev)        action=fix_wlandev ;;
		--reset-eth0)         action=reset_eth0  ;;
		--wlandev=*)          WLANDEV_OVERRIDE="${1#*=}" ;;
		--yes|-y)             say=yes ;;
		--help|-h)            sed -n '2,11p' "$0"; exit 0 ;;
		*)                    echo "$PROG: unknown arg: $1" >&2; exit 2 ;;
	esac
	shift
done

have() { command -v "$1" >/dev/null 2>&1; }

getenv() { # VAR -> value or empty
	if have fw_printenv; then
		fw_printenv -n "$1" 2>/dev/null
	else
		printf ''
	fi
}

mask() { # "secret string" -> "***last3"
	s=$1
	last3=${s#${s%???}}
	printf '***%s\n' "$last3"
}

hr() { printf '\n--- %s ---\n' "$1"; }

DISPATCHER=/etc/wireless/usb
[ -f "$DISPATCHER" ] || DISPATCHER=

slot_match() {
	# exit 0 when /etc/wireless/usb matched $1, 1 otherwise.
	[ -n "$DISPATCHER" ] && "$DISPATCHER" "$1" 2>/dev/null
}

show() {
	wld=$(getenv wlandev)
	wls=$(getenv wlanssid)
	wlp=$(getenv wlanpass)

	hr "u-boot env"
	printf 'wlandev  = %s\n' "${wld:-<unset>}"
	printf 'wlanssid = %s\n' "${wls:-<unset>}"
	if [ -n "$wlp" ]; then
		printf 'wlanpass = %s\n' "$(mask "$wlp")"
	else
		printf 'wlanpass = <unset>\n'
	fi

	hr "dispatcher /etc/wireless/usb"
	if [ -z "$DISPATCHER" ]; then
		echo 'dispatcher missing'
		return
	fi
	if [ -z "$wld" ]; then
		echo 'wlandev unset -- S40network keeps eth0 on DHCP, no wifi is taken'
	elif slot_match "$wld"; then
		echo "matched; wlandev=\"$wld\" -- a modprobe already happened at boot"
	else
		printf '!!! no slot matches "%s"\n' "$wld" >&2
		printf '    modprobe never ran. wlan0 is dead. eth0 is parked on 192.168.2.10.\n' >&2
	fi

	if have lsmod; then
		hr "kernel modules (wifi stack)"
		lsmod 2>/dev/null | grep -E "cfg80211|mac80211|8188|8189|rtl|wlan|wifi" || true
	fi

	hr "interfaces (link + ip)"
	if have ip; then
		ip -br link show 2>/dev/null
		echo
		ip -br -4 addr show 2>/dev/null
	else
		ifconfig 2>/dev/null | grep -E "^[a-z]|inet "
	fi

	if have wpa_cli; then
		hr "wpa_supplicant on wlan0"
		wpa_cli -i wlan0 status 2>&1 | head -30
		echo
		echo "scan:"
		wpa_cli -i wlan0 scan_results 2>&1 | head -10
	else
		printf '\n(no wpa_cli; wpa_supplicant-openipc not installed)\n'
	fi

	if have dmesg; then
		hr "kernel log (last wifi-ish lines)"
		dmesg 2>/dev/null | grep -iE "wifi|wlan|cfg80211|mac80211|rtl|wpa" | tail -25
	fi

	hr "verdict"
	if [ -z "$wld" ]; then
		echo 'Set wlandev to enable wifi:'
		echo '   fw_setenv wlandev rtl8188fu-generic'
	elif ! slot_match "$wld"; then
		echo "Run '$PROG --fix-wlandev' to recover. Conservative by design:"
		echo "   - it only acts when current wlandev has no slot"
		echo "   - it sets a value the dispatcher recognises (default rtl8188fu-generic;"
		echo "     override with --wlandev=NAME)"
	fi

	if have wpa_cli; then
		STATE=$(wpa_cli -i wlan0 status 2>/dev/null | sed -n 's/^wpa_state=//p')
		case "$STATE" in
			COMPLETED) ;; # silent on success
			*) printf '\n!!! wpa_state=%s (want COMPLETED)\n' "${STATE:-<no status>}" >&2 ;;
		esac
	fi
}

fix_wlandev() {
	wld=$(getenv wlandev)
	TARGET=${WLANDEV_OVERRIDE:-rtl8188fu-generic}

	if [ -z "$wld" ]; then
		echo "wlandev is unset; nothing to fix." >&2
		exit 0
	fi
	if slot_match "$wld"; then
		printf '"%s" matches a slot already -- no fix needed.\n' "$wld"
		exit 0
	fi

	if [ "$say" != yes ]; then
		printf 'about to: fw_setenv wlandev "%s" (was "%s"). Continue? [y/N] ' "$TARGET" "$wld"
		read -r yn
		case "$yn" in y|Y|yes|YES|Yes) ;; *) echo 'aborted.'; exit 1 ;; esac
	fi

	fw_setenv wlandev "$TARGET"
	echo "wlandev -> $TARGET"
	echo "Reboot, or after setting wlanssid/wlanpass:"
	echo "   /etc/init.d/S40network restart"
}

reset_eth0() {
	printf 'Bringing eth0 down and trying DHCP... '
	ifconfig eth0 down 2>/dev/null
	if have udhcpc; then
		udhcpc -i eth0 -t 5 -f -q 2>&1 | head -10
	else
		echo '(no udhcpc; eth0 left down)'
	fi
}

case "$action" in
	show)        show ;;
	fix_wlandev) fix_wlandev ;;
	reset_eth0)  reset_eth0 ;;
esac
